# Copie este arquivo para .env em ambiente local.
# Em deploy, prefira cadastrar estas variáveis no painel da hospedagem.

# Token para acessar /admin, /proxy-status, /proxy-update e /debug/fetchers.
ADMIN_TOKEN=troque-este-token

# Proxy opcional. Se vazio, o modo requests tenta direto sem proxy.
PROXY_URL=

# Gist opcional para persistir a URL do proxy entre deploys/restarts.
GITHUB_TOKEN=
GITHUB_GIST_ID=

# Base da API do SofaScore.
SOFASCORE_BASE_URL=https://www.sofascore.com/api/v1

# Modo de fetch:
# requests = comportamento antigo/padrão
# scrapling = força Scrapling direto, sem proxy
# auto = tenta Scrapling direto; se falhar, cai para requests/proxy
SOFASCORE_FETCHER=requests

# Logs e timeouts.
LOG_LEVEL=INFO
MAX_RETRIES=8
RETRY_SLEEP=0.5
REQUEST_TIMEOUT=20.0
STATUS_TIMEOUT=10.0

# Ajustes do Scrapling.
SCRAPLING_IMPERSONATE=chrome
SCRAPLING_HTTP3=false
SCRAPLING_STEALTHY_HEADERS=true
AUTO_TRY_SCRAPLING_BEFORE_PROXY=true
