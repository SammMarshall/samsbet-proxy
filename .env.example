# Variáveis opcionais para testar camadas novas sem alterar o fluxo antigo.
# ADMIN_TOKEN e PROXY_URL não ficam aqui; mantenha como já estava antes na hospedagem/Gist.

# Base da API do SofaScore.
SOFASCORE_BASE_URL=https://www.sofascore.com/api/v1

# Modo de fetch:
# requests = comportamento antigo/padrão
# scrapling = força Scrapling direto, sem proxy
# home_relay = usa o relay residencial/celular via túnel
# auto = tenta Scrapling direto; se falhar, cai para requests/proxy
SOFASCORE_FETCHER=home_relay

# Relay residencial/celular (só SofaScore). Não coloque o token real neste arquivo.
HOME_RELAY_URL=https://xxxxx.trycloudflare.com
HOME_RELAY_TOKEN=changeme

# A Betano usa GET /betano/{path} neste proxy (Scrapling/curl_cffi ou PROXY_URL).
# Não passa pelo home_relay.

# Logs e timeouts.
LOG_LEVEL=INFO
MAX_RETRIES=8
RETRY_SLEEP=0.5
REQUEST_TIMEOUT=20.0
STATUS_TIMEOUT=10.0

# Ajustes do Scrapling.
SCRAPLING_IMPERSONATE=chrome
SCRAPLING_HTTP3=false
SCRAPLING_STEALTHY_HEADERS=true
AUTO_TRY_SCRAPLING_BEFORE_PROXY=true
